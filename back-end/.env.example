SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

POSTGRES_DB=serve
POSTGRES_USER=serve
POSTGRES_PASSWORD=serve
POSTGRES_HOST=db
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:3000,http://127.0.0.1:3000
PAGE_SIZE=12
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# Gmail: use uma senha de aplicativo, não a senha da conta.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SALE_EMAIL_ENABLED=False
EMAIL_TIMEOUT=10

# Consultas de localização: cache compartilhado em produção.
LOCATION_TIMEOUT=6
GEOCODER_URL=https://nominatim.openstreetmap.org/search
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_RESULT_LIMIT=2000
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=serve-location
